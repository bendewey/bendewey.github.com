<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Ben Dewey is a product and technology leader in Charleston, South Carolina." />
    <title>@ViewData["Title"] · Ben Dewey</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="site-shell">
        <header class="site-header">
            <a class="site-name" asp-page="/Index">Ben Dewey</a>
            <nav aria-label="Primary navigation">
                <a asp-page="/Projects/Index">Work</a>
                <a asp-page="/About">Meet Ben</a>
                <a asp-page="/WritingAndSpeaking">Books &amp; Talks</a>
                <a class="nav-contact" asp-page="/Contact">Contact</a>
            </nav>
        </header>
        <main>
            @RenderBody()
        </main>
        <footer class="site-footer">
            <span>Ben Dewey · Charleston, South Carolina</span>
            <a asp-page="/Contact">Contact Ben</a>
        </footer>
    </div>
</body>
</html>
