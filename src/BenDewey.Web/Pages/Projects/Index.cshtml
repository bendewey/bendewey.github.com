@page
@model IndexModel
@{
    ViewData["Title"] = "Selected work";
}

<section class="page-intro">
    <p class="eyebrow">Project inventory</p>
    <h1>Leading complex product work from direction to delivery.</h1>
    <p>This living inventory is generated from Ben’s canonical project history. These public summaries use generalized client labels and describe only work that is appropriate to share openly.</p>
</section>

<section class="project-grid" aria-label="Project inventory">
    @foreach (var project in Model.Projects)
    {
        <article class="project-card">
            <p class="eyebrow">@project.Id</p>
            <h2>@project.Title</h2>
            <p>@project.Summary</p>
            @if (!string.Equals(project.Role, "Unknown", StringComparison.OrdinalIgnoreCase))
            {
                <p class="project-role">@project.Role</p>
            }
        </article>
    }
</section>

<section class="inventory-callout">
    <h2>Looking for fuller project context?</h2>
    <p>Approved reviewers can access additional role, scope, and technology context. Client names and confidential information remain excluded.</p>
    <a class="button" asp-page="/Projects/Full">Open protected inventory</a>
</section>
