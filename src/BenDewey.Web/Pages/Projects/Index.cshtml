@page
@model IndexModel
@{
    ViewData["Title"] = "Selected work";
}

<section class="page-intro">
    <p class="eyebrow">Selected work</p>
    <h1>Leading complex product work from direction to delivery.</h1>
    <p>Three examples of product leadership, experience design, and founder work.</p>
</section>

<section class="project-grid" aria-label="Selected projects">
    @foreach (var project in Model.Projects)
    {
        <article class="project-card">
            <h2>@project.Title</h2>
            <p>@project.Summary</p>
            @if (!string.IsNullOrWhiteSpace(project.Role))
            {
                <p class="project-role">@project.Role</p>
            }
        </article>
    }
</section>

@if (Model.ShowProtectedInventory)
{
    <section class="inventory-callout">
        <h2>Looking for fuller project context?</h2>
        <p>Additional project context is available to reviewers with an access password.</p>
        <a class="button" asp-page="/Projects/Full">Open protected inventory</a>
    </section>
}
