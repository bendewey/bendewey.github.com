@page
@{
    ViewData["Title"] = "Selected work";
}

<section class="page-intro">
    <p class="eyebrow">Selected work</p>
    <h1>Leading complex product work from direction to delivery.</h1>
    <p>These public summaries use generalized client labels and describe only work that is appropriate to share openly.</p>
</section>

<section class="project-grid" aria-label="Selected projects">
    <article class="project-card">
        <p class="eyebrow">Public sector</p>
        <h2>State public housing department</h2>
        <p>Overall product ownership and product leadership for a multi-module housing transformation.</p>
        <p class="project-role">Product direction · Roadmap · Backlog · UX collaboration</p>
    </article>
    <article class="project-card">
        <p class="eyebrow">Legal services</p>
        <h2>Top NYC law firm</h2>
        <p>UX leadership and design-thinking facilitation for client intelligence and reporting concepts.</p>
        <p class="project-role">UX design lead · Workshops · Product roadmap</p>
    </article>
    <article class="project-card">
        <p class="eyebrow">Real estate</p>
        <h2>Commercial real-estate reporting</h2>
        <p>Experience design for a Power BI reporting dashboard, developed alongside the data-modeling and warehouse work.</p>
        <p class="project-role">UX design · Power BI · Design thinking</p>
    </article>
    <article class="project-card">
        <p class="eyebrow">Founder work</p>
        <h2>Launched resale-inventory product</h2>
        <p>A launched Nuology product for inventory capture, organization, and search across mobile and web.</p>
        <p class="project-role">Founder work · Product development</p>
    </article>
</section>

<section class="inventory-callout">
    <h2>Looking for the full project inventory?</h2>
    <p>Approved reviewers can access additional role, scope, and technology context. Client names and confidential information remain excluded.</p>
    <a class="button" asp-page="/Projects/Full">Open protected inventory</a>
</section>
