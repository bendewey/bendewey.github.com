@page
@model WritingAndSpeakingModel
@{
    ViewData["Title"] = "Writing and speaking";
}

<section class="page-intro">
    <p class="eyebrow">Writing &amp; speaking</p>
    <h1>Sharing the work behind the work.</h1>
    <p>Ben has written technical books and spoken at conferences and community events about application development, user experience, and technology platforms. This is a dated archive of that work, recovered from his legacy site.</p>
</section>

<section class="content-section">
    <h2>Books</h2>
    <ul>
        <li><em>A Guide to Windows 8 Apps</em>, O’Reilly Media.</li>
        <li><em>Building Web Applications with Visual Studio 2017</em>, Apress, co-author.</li>
        <li><em>Building Web Applications with .NET Core 2.1 and JavaScript</em>, Apress, co-author.</li>
    </ul>
</section>

<section class="content-section" aria-labelledby="engagements-title">
    <h2 id="engagements-title">Speaking engagements</h2>
    <p>The legacy site recorded @Model.Engagements.Count engagements from 2009 through 2015. Session titles reflect the platform and language of their original date.</p>
    @foreach (var year in Model.Engagements.GroupBy(engagement => engagement.Date.Year).OrderByDescending(group => group.Key))
    {
        <h3 class="engagement-year">@year.Key</h3>
        <ul class="engagement-list">
            @foreach (var engagement in year.OrderByDescending(item => item.Date))
            {
                <li><strong>@engagement.Title</strong><span>@engagement.Venue · @(engagement.DateLabel ?? engagement.Date.ToString("MMMM d, yyyy"))</span></li>
            }
        </ul>
    }
</section>
