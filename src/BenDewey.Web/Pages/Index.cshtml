@page
@model IndexModel
@{
    ViewData["Title"] = "Product and technology leadership";
}

<section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
        <p class="eyebrow">Independent product &amp; technology leadership</p>
        <h1 id="hero-title">I lead teams building useful digital products.</h1>
        <p class="intro">A product and technology leader in Charleston, South Carolina, seeking my next leadership opportunity and available for select advisory work.</p>
        <a class="button" href="#work">Explore the work</a>
    </div>
    <div class="hero-image">
        <img src="~/images/ben-dewey-stage-hero.png" alt="Ben Dewey presenting on a conference stage" />
    </div>
</section>

<section class="work" id="work" aria-labelledby="work-title">
    <p class="eyebrow">Selected work</p>
    <div>
        <h2 id="work-title">Leadership, products, and evidence worth exploring.</h2>
        <div class="work-item">
            <h3>Public-sector product leadership</h3>
            <p>Product direction and delivery leadership for a multi-module transformation at a public housing department.</p>
        </div>
        <div class="work-item">
            <h3>Data products for legal services</h3>
            <p>Client intelligence and Power BI dashboard work for a top NYC law firm, designed to make complex information more useful.</p>
        </div>
        <div class="work-item">
            <h3>Founder work</h3>
            <p>Nuology and ThriftTrack: bringing product ideas into the world with a practical focus on the people who use them.</p>
        </div>
    </div>
</section>

<section class="meet" aria-labelledby="meet-title">
    <p class="eyebrow">Meet Ben</p>
    <div>
        <h2 id="meet-title">The person behind the work.</h2>
        <p>Ben’s career spans hands-on application development, technical community leadership, product work, and leading teams through complex delivery. He brings people together around clear goals, useful experiences, and progress that holds up in the real world.</p>
        <a class="text-link" asp-page="/About">Read Ben’s story <span aria-hidden="true">→</span></a>
    </div>
</section>
